# Replace this example with the real connection string from Neon. Do not use it as-is.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Admin sign-in; replace both values with private credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret

# WhatsApp destination; use international format
BOSS_WHATSAPP_NUMBER=

# Optional Twilio inbound WhatsApp webhook configuration
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=https://your-public-domain.example/api/whatsapp/webhook
